<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/habit_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/habit_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="8dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/habit_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
    <TextView android:id="@+id/habit_mark" android:layout_width="22dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textSize="20sp" android:gravity="end" android:includeFontPadding="false"/>
</LinearLayout>
