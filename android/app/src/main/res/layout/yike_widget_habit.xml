<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/habit_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:id="@+id/habit_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no"/>
<TextView android:id="@+id/habit_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/habit_mark" android:layout_width="24dp" android:layout_height="wrap_content" android:textSize="18sp" android:gravity="end"/>
</LinearLayout>